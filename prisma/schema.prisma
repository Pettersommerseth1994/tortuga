// Tortuga — datamodell.
//
// PostgreSQL. Lokalt kjører `npm run db:start` en innebygd Postgres uten
// Docker; i produksjon brukes en managed Postgres (Neon, Supabase, …).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  matches TrackedMatch[]
  combos  ComboBet[]
}

/// En kamp brukeren har tatt med i Tortuga. Maks tre aktive om gangen
/// (håndheves i lib/actions/matches.ts).
model TrackedMatch {
  id         String    @id @default(cuid())
  userId     String
  /// Kamp-ID hos dataleverandøren (ESPN).
  eventId    String
  homeName   String
  awayName   String
  kickoff    DateTime
  createdAt  DateTime  @default(now())
  /// Settes når kampen er ferdig og plassen frigjøres.
  archivedAt DateTime?

  /// Planen ved pause: når den ble låst inn, og stillingen den ble laget på ("2-1").
  lockedAt    DateTime?
  lockedScore String?
  /// Planen før avspark (sluttresultat fra 0–0).
  preLockedAt DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bets Bet[]

  @@unique([userId, eventId])
  @@index([userId, archivedAt])
}

/// Ett bet i sjekklisten: riktig sluttresultat, f.eks. 3–1.
model Bet {
  id             String    @id @default(cuid())
  trackedMatchId String
  /// "pre" = lagt før avspark, "ht" = lagt ved pause.
  kind           String    @default("ht")
  homeGoals      Int
  awayGoals      Int
  /// Modellens sannsynlighet da planen ble låst (0–1).
  probability    Float
  odds           Float?
  stake          Float?
  placed         Boolean   @default(false)
  placedAt       DateTime?

  trackedMatch TrackedMatch @relation(fields: [trackedMatchId], references: [id], onDelete: Cascade)

  @@unique([trackedMatchId, kind, homeGoals, awayGoals])
}

/// En kombinasjon (dobbel/trippel) i sjekklisten: ett sluttresultat per kamp, og alle må treffe.
model ComboBet {
  id     String @id @default(cuid())
  userId String
  /// "pre" = lagt før avspark, "ht" = lagt ved pause.
  kind   String
  /// [{ eventId, homeName, awayName, home, away }, …] — 2 eller 3 ben.
  legs   Json
  /// Kampene kombinasjonen gjelder (sorterte kamp-ID-er, «|»-skilt). Brukes til å erstatte ikke-plasserte ved ny låsing.
  setKey String
  /// Akkurat denne kombinasjonen av resultater, f.eks. «401:1-0|402:2-1».
  signature   String
  probability Float
  odds        Float
  stake       Int?
  placed      Boolean   @default(false)
  placedAt    DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, signature])
  @@index([userId, setKey])
}
