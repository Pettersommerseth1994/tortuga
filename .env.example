# Kopier til .env og fyll ut.

# PostgreSQL. Lokalt uten Docker:  npm run db:start  (egen terminal)
DATABASE_URL="postgresql://postgres:tortuga@localhost:5432/tortuga?schema=public"

# Generer: openssl rand -base64 32
AUTH_SECRET=""
# AUTH_URL="https://din-domene.no"   # kun i produksjon bak proxy
# AUTH_TRUST_HOST=true               # kreves hvis du kjører `next start` selv
